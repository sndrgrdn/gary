{
  "colors": {
    "background": "background",
    "foreground": "foreground",
    "accent": "accent",
    "dim": ["dark_foreground", "mix(foreground, background, 0.45)"],
    "bright": ["bright_foreground", "mix(foreground, contrast(background), 0.4)"],
    "good": ["green", "color2", "#4c9a52"],
    "bad": ["red", "color1", "#d9534f"],
    "panel": ["lighter_background", "mix(background, foreground, 0.06)"],
    "border": "alpha(foreground, 0.12)",
    "hover": "alpha(foreground, 0.1)",
    "selected": "alpha(accent, 0.25)",
    "bar": "background"
  },
  "fonts": {
    "body": { "family": "monospaced", "size": 12, "weight": "regular" },
    "strong": { "family": "monospaced", "size": 12, "weight": "bold" },
    "title": { "family": "monospaced", "size": 14, "weight": "semibold" }
  },
  "spacing": { "item": 8, "section": 14, "edge": 16 },
  "bar": { "height": 32 },
  "motion": { "fade": 0.15 },
  "styles": {
    "default": { "color": "foreground", "font": "body" },
    "active": { "color": "accent", "font": "strong" },
    "dim": { "color": "dim" },
    "bright": { "color": "bright" },
    "good": { "color": "good" },
    "bad": { "color": "bad" },
    "title": { "color": "bright", "font": "title" },
    "panel": { "background": "panel", "radius": 12, "padding": 14 },
    "surface": { "background": "panel", "radius": 12 },
    "hover": { "background": "hover", "radius": 6 },
    "selected": { "color": "bright", "background": "selected", "radius": 6 }
  }
}
