{
  "colors": {
    "background": "background",
    "foreground": "foreground",
    "accent": "accent",
    "dim": "mix(foreground, background, 0.35)",
    "bright": ["bright_foreground", "mix(foreground, contrast(background), 0.4)"],
    "good": ["green", "color2", "#4c9a52"],
    "bad": ["red", "color1", "#d9534f"],
    "panel": "background",
    "border": "alpha(foreground, 0.12)",
    "secondary": "mix(foreground, background, 0.3)",
    "control": "alpha(foreground, 0.04)",
    "on-accent": "contrast(accent)",
    "hover": "alpha(foreground, 0.08)",
    "selected": "alpha(foreground, 0.18)",
    "scrim": "alpha(background, 0.5)",
    "bar": "background"
  },
  "fonts": {
    "body": { "family": "system", "size": 13, "weight": "regular" },
    "strong": { "family": "system", "size": 13, "weight": "semibold" },
    "title": { "family": "system", "size": 15, "weight": "semibold" },
    "mono": { "family": "monospaced", "size": 12, "weight": "regular" }
  },
  "spacing": { "item": 8, "section": 16, "edge": 20 },
  "radius": { "control": 6, "surface": 12 },
  "bar": {
    "height": 32,
    "fonts": {
      "body": { "family": "monospaced", "size": 12, "weight": "regular" },
      "strong": { "family": "monospaced", "size": 12, "weight": "bold" },
      "title": { "family": "monospaced", "size": 14, "weight": "semibold" }
    }
  },
  "motion": { "fade": 0.15 },
  "styles": {
    "default": { "color": "foreground", "font": "body" },
    "active": { "color": "accent", "font": "strong" },
    "dim": { "color": "dim" },
    "secondary": { "color": "secondary" },
    "bright": { "color": "bright" },
    "good": { "color": "good" },
    "bad": { "color": "bad" },
    "title": { "color": "foreground", "font": "title" },
    "mono": { "font": "mono" },
    "panel": { "background": "panel", "radius": "surface", "padding": 16 },
    "surface": {
      "background": "panel",
      "radius": "surface",
      "border": { "color": "accent", "width": 2 }
    },
    "picker": {
      "background": "background",
      "radius": "surface",
      "border": { "color": "foreground", "width": 2 }
    },
    "tooltip": {
      "background": "alpha(background, 0.97)",
      "radius": "control",
      "padding": [5, 8],
      "fontSize": 11,
      "border": { "color": "foreground" }
    },
    "toast": {
      "background": "panel",
      "radius": "surface",
      "padding": [12, 16],
      "width": 340,
      "border": { "color": "accent", "width": 2 }
    },
    "toast-title": { "color": "foreground", "font": "strong" },
    "toast-body": { "color": "secondary" },
    "toast-icon": { "color": "accent", "fontSize": 20 },
    "hover": { "background": "hover", "radius": "control" },
    "selected": {
      "color": "foreground",
      "font": "strong",
      "background": "selected",
      "radius": "control"
    },
    "highlight": { "color": "accent", "background": "hover", "radius": "control" },
    "button": {
      "background": "control",
      "radius": "control",
      "padding": [4, 12],
      "border": { "color": "alpha(foreground, 0.4)" }
    },
    "button-hover": { "background": "hover", "border": { "color": "alpha(foreground, 0.25)" } },
    "primary": {
      "color": "on-accent",
      "background": "accent",
      "radius": "control",
      "padding": [4, 12]
    },
    "primary-hover": { "background": "mix(accent, foreground, 0.15)" }
  }
}
