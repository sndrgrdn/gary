{
  "$schema": "./manifest.schema.json",
  "schemaVersion": 1,
  "id": "example.osd",
  "name": "OSD",
  "version": "0.1.0",
  "kinds": ["panel"],
  "entryPoints": { "panel": "panel.tsx" },
  "keepLoaded": true,
  "surfaces": { "panel": ["main", "osd"] },
  "subscribes": ["audio"],
  "uses": ["audio"],
  "mediakeys": { "panel": ["volume-up", "volume-down"] }
}
