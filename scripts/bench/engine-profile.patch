index 1ba268d..0396ebb 100644
--- a/Sources/gary/PluginEngine.swift
+++ b/Sources/gary/PluginEngine.swift
@@ -23,8 +23,15 @@ final class PluginEngine: @unchecked Sendable {
     }
 
     func run(_ plugin: PluginID, in context: JSContext, _ body: () -> JSValue?) throws -> JSValue? {
+        let behind = state.withLock { current?.plugin.rawValue }
+        let asked = now()
         entry.lock()
-        defer { entry.unlock() }
+        let took = now()
+        defer {
+            let held = now() - took
+            entry.unlock()
+            EngineProfile.shared.add(plugin.rawValue, behind: behind, wait: took - asked, hold: held)
+        }
         let result = timed(plugin, body)
         guard result.stopped else { return result.value }
         _ = timed(plugin) { context.evaluateScript("0") }
@@ -63,3 +70,18 @@ final class PluginEngine: @unchecked Sendable {
         }, Unmanaged.passUnretained(self).toOpaque())
     }
 }
+
+final class EngineProfile: @unchecked Sendable {
+    static let shared = EngineProfile()
+    private let lock = NSLock()
+    private var entries: [(plugin: String, behind: String?, wait: Double, hold: Double, at: Double)] = []
+
+    func add(_ plugin: String, behind: String?, wait: Double, hold: Double) {
+        let at = now()
+        lock.withLock { entries.append((plugin, behind, wait, hold, at)) }
+    }
+
+    func snapshot() -> [(plugin: String, behind: String?, wait: Double, hold: Double, at: Double)] {
+        lock.withLock { entries }
+    }
+}
